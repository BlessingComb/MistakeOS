# CLIENT/PUBLIC: bundled into web or native apps. Use public SDK keys only.
# Never place service-role, RevenueCat secret, or webhook keys in EXPO_PUBLIC_*.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=
EXPO_PUBLIC_MISTAKE_ANALYSIS_URL=
EXPO_PUBLIC_MISTAKEOS_CLASSROOM_DEMO=

# SERVER-ONLY: set in the server/Edge Function environment; never bundle in a client.
# Only configure values required by the service you run.
GROQ_API_KEY=
GROQ_MODEL=
GROQ_INPUT_USD_PER_MILLION=
GROQ_OUTPUT_USD_PER_MILLION=
MISTAKEOS_ALLOWED_ORIGINS=
MISTAKE_ANALYSIS_PORT=
REVENUECAT_WEBHOOK_AUTH=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
